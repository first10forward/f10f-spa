# Azure Storage Configuration for F10F Data Storage
# You'll need to create these in Azure Portal and add the actual values to .env.local

# Azure Storage Account Name (the name you choose when creating the storage account)
VITE_AZURE_STORAGE_ACCOUNT_NAME=your_storage_account_name

# Azure Storage SAS Token (generate this in Azure Portal with read/write permissions)
VITE_AZURE_STORAGE_SAS_TOKEN=your_sas_token_here

# Container name for storing JSON files (will be created automatically)
VITE_AZURE_STORAGE_CONTAINER_NAME=f10f-data

# Azure Communication Services endpoint URL
VITE_AZURE_COMMUNICATION_ENDPOINT=https://f10f-communications.unitedstates.communication.azure.com/

# Azure Communication Services access key
VITE_AZURE_COMMUNICATION_ACCESS_KEY=

# Optional: Custom domain for sending emails (if configured)
VITE_FROM_EMAIL_DOMAIN=first10forward.org

# Cloudflare Turnstile — form spam protection
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Test site key (always passes): 1x00000000000000000000AA
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Cloudflare Turnstile secret key — Azure Functions only, never use VITE_ prefix
CLOUDFLARE_TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Azure Communication Services — Azure Functions server-side (api/ directory)
# These duplicate the VITE_ vars above but run in the functions runtime, not the browser
AZURE_COMMUNICATION_ENDPOINT=https://f10f-communications.unitedstates.communication.azure.com/
AZURE_COMMUNICATION_ACCESS_KEY=your_access_key